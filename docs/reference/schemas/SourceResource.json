    "ConceptCandidate": {
      "additionalProperties": false,
      "description": "Retrieval candidate only. No equivalence, mapping status or approval field.",
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "definition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Definition"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/SemanticEvidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "identifier": {
          "minLength": 1,
          "title": "Identifier",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "match_basis": {
          "enum": [
            "source_annotation",
            "normalized_identifier",
            "exact_vocabulary_match",
            "lexical",
            "model_inferred"
          ],
