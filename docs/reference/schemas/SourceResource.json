          "type": "string"
        },
        "ontology": {
          "minLength": 1,
          "title": "Ontology",
          "type": "string"
        }
      },
      "required": [
        "identifier",
        "label",
        "ontology",
        "match_basis",
        "evidence"
      ],
      "title": "ConceptCandidate",
      "type": "object"
    },
    "EvidenceKind": {
      "enum": [
        "SOURCE_DOCUMENTED",
        "OBSERVED_IN_DATA",
        "DERIVED_DETERMINISTICALLY",
        "MODEL_JUDGMENT",
        "HUMAN_DECISION",
        "MISSING_EVIDENCE"
