{
  "$defs": {
    "ScopeFinding": {
      "additionalProperties": false,
      "properties": {
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "jurisdiction": {
          "title": "Jurisdiction",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "scope": {
          "title": "Scope",
          "type": "string"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "NEEDS_EVIDENCE",
            "NOT_APPLICABLE"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "jurisdiction",
        "status",
        "evidence_ids",
        "rationale"
      ],
      "title": "ScopeFinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "approved_scopes": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Approved Scopes",
      "type": "array"
    },
    "findings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ScopeFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "human_receipt_reference": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Human Receipt Reference"
    },
    "origin": {
      "default": "DRAFT",
      "enum": [
        "DRAFT",
        "EXTERNAL_HUMAN_REVIEW"
      ],
      "title": "Origin",
      "type": "string"
    },
    "plan_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Plan Digest",
      "type": "string"
    },
    "receipt_verified_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Receipt Verified By"
    },
    "reviewer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewer"
    },
    "timestamp": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Timestamp"
    },
    "version": {
      "const": "fire-full-lake-authorization-v1",
      "default": "fire-full-lake-authorization-v1",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "plan_digest"
  ],
  "title": "LakeAuthorization",
  "type": "object"
}
