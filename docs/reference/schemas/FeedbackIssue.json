{
  "additionalProperties": false,
  "properties": {
    "category": {
      "enum": [
        "semantics",
        "harmonization",
        "representation",
        "rights",
        "interface"
      ],
      "title": "Category",
      "type": "string"
    },
    "detail": {
      "maxLength": 4000,
      "minLength": 5,
      "title": "Detail",
      "type": "string"
    },
    "group_id": {
      "pattern": "^(governance-[1-3]|synthesis-[1-6])$",
      "title": "Group Id",
      "type": "string"
    },
    "permission": {
      "const": "issue_only_no_execution_authority",
      "default": "issue_only_no_execution_authority",
      "title": "Permission",
      "type": "string"
    },
    "state": {
      "const": "open",
      "default": "open",
      "title": "State",
      "type": "string"
    },
    "summary": {
      "maxLength": 240,
      "minLength": 5,
      "title": "Summary",
      "type": "string"
    },
    "target_id": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Target Id",
      "type": "string"
    }
  },
  "required": [
    "target_id",
    "group_id",
    "category",
    "summary",
    "detail"
  ],
  "title": "FeedbackIssue",
  "type": "object"
}
